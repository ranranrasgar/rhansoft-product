# ── Database (Laragon PostgreSQL) ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rhansoft_store
DB_USER=postgres
DB_PASSWORD=

# ── Midtrans ────────────────────────────────────────────────
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_SANDBOX_CLIENT_KEY=your_sandbox_client_key
MIDTRANS_SANDBOX_SERVER_KEY=your_sandbox_server_key

# Production keys
MIDTRANS_PRODUCTION_CLIENT_KEY=your_production_client_key
MIDTRANS_PRODUCTION_SERVER_KEY=your_production_server_key

# Set MIDTRANS_ENV=production to switch to production keys
MIDTRANS_ENV=sandbox

# Akun Midtrans dipakai beberapa website, sedangkan dashboard hanya menyimpan SATU alamat notifikasi.
# Isi alamat webhook toko ini agar Midtrans juga mengirim notifikasi ke sini untuk transaksi toko ini
# (alamat akun tetap menerima seperti biasa). Boleh sampai 3 alamat, dipisah koma. Kosong = tidak dipakai.
# Contoh production: https://app.rhantech.com/api/webhook
MIDTRANS_APPEND_NOTIFICATION_URL=

# Metode yang tampil di checkout (pisah koma): card, gopay, bank_transfer, shopeepay
# Isi hanya yang sudah aktif di dashboard Midtrans.
# Kosong = pilihan default Midtrans (popup menampilkan semua metode yang aktif).
ENABLED_PAYMENT_METHODS=

# ── Backend ─────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Cloudflare R2 (S3-compatible) ───────────────────────────
# Isi dengan kredensial R2 Anda dari dashboard Cloudflare > R2
R2_ACCOUNT_ID=53b1d28c30d7f45627c67b7e590626b9
R2_BUCKET_NAME=rhansoft-product
R2_ACCESS_KEY_ID=c2e8a29c37d828bc248d6f246d5153a3
R2_SECRET_ACCESS_KEY=b6fa2c65241e59f77c14ed5b5e2f7e18212b88e0e3a8aa66b04c759af89d9db9
# Public URL untuk akses gambar (pakai R2 public dev URL atau custom domain)
# Contoh: https://pub-xxxxx.r2.dev  atau  https://cdn.rhansoft.com
R2_PUBLIC_URL=https://pub-d1a4a777f8474008ac7baf230a1e406c.r2.dev

# ── SMTP Email (nodemailer) ────────────────────────────────
# Untuk Gmail, gunakan App Password (bukan password biasa)
# https://support.google.com/accounts/answer/185833
APP_NAME="apps.rhantech.com"
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ranran.rhansoft@gmail.com 
MAIL_PASSWORD=hyvwrwecdpojgwef
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ranran.rhansoft@gmail.com
MAIL_FROM_NAME="rhantech.com"

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"   
