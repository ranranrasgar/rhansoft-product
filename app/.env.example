# ── Frontend (.env di root app/) ────────────────────────────────

# Google OAuth Client ID — buat di https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API base URL
VITE_API_BASE=http://localhost:3001

# ── Backend (server/.env) ───────────────────────────────────────

# JWT Secret — ganti dengan random string panjang di production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=365d

# Google OAuth Client ID (sama dengan frontend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
